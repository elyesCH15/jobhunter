# Copy to .env for local runs. Never commit .env — the same values go in GitHub Secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Free job APIs (optional — sources without keys are skipped, not failed)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# Free LLMs (any subset; tried in LLM_CHAIN order)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_CHAIN=gemini,groq,openrouter
# Override models if a free model is renamed or retired:
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
